# Copiar para .env.nomad (NÃO fazer commit) e preencher.
# Gerar segredos com:  python -c "import secrets; print(secrets.token_urlsafe(32))"

ROBOTS=robot1,robot2,robot3,robot4,robot5
AGENT_TOKEN=trocar-por-um-segredo-longo     # o mesmo valor vai para /etc/tb4_agent.env em cada robô
# opcional: chave da turma pedida no connect (vazio = sem chave)
STUDENT_KEY=
SESSION_TIMEOUT_S=30                        # sessão de aluno expira após X s sem pedidos
RELAY_HOST_PORT=10120                       # porto em 127.0.0.1 no servidor (confirmar que está livre)
LOG_LEVEL=INFO
# chave por robô (uma por grupo), tem prioridade sobre STUDENT_KEY. Ex.: ROBOT_KEYS=robot1:k7mq,robot2:p3xa
ROBOT_KEYS=

# túnel SSH de administração pelo relay (tools/ws_tunnel.py). Vazio = desligado.
ADMIN_TOKEN=
TUNNEL_PORTS=22

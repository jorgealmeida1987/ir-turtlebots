# Copiado para /etc/tb4_agent.env pelo install.sh (permissões 600). Um por robô.
ROBOT_NAME=robot1
RELAY_URL=wss://tb.lexicode-consulting.pt/agent
AGENT_TOKEN=igual-ao-AGENT_TOKEN-do-.env.nomad

# Opcional
#ROS_NS=/robot1

#MAX_W=1.9                # rad/s
#TOPIC_MAX_HZ=10          # limite por tópico (exceto scan)
#SCAN_MAX_HZ=20
#CMD_VEL_STAMPED=1        # Jazzy: TwistStamped; Humble: 0 (Twist)
#BLOCKED_TOPICS=cmd_vel,cmd_vel_unstamped,robot_description
